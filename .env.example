# Copy this file to .env and fill in values.
# NEVER commit the real .env file — it is gitignored.

# --- Trading mode: backtest | testnet | live ---
TRADING_MODE=backtest

# --- Binance API (only needed for testnet / live) ---
# RULE 1: Create keys with TRADE permission ONLY. Never enable Withdrawals.
# RULE 2: Set an IP whitelist on the key.
# RULE 3: For TRADING_MODE=testnet use TESTNET keys:
#         https://testnet.binance.vision/ (spot testnet)
#         https://testnet.binancefuture.com/ (futures testnet)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# spot | usdt_future  (usdt_future = leveraged contracts — high risk)
BINANCE_ACCOUNT_TYPE=spot
